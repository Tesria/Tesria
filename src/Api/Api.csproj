<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tesria.Api</RootNamespace>
    <AssemblyName>Tesria.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- One version, set by the release (dev-plan 16.1): a pushed tag vX.Y.Z
         builds as X.Y.Z (GitHub Actions passes TESRIA_VERSION to the Docker
         build, which sets InformationalVersion). A build without one is the
         next release with -dev, so it can never pass for a release. -->
    <Version>0.5.0</Version>
    <InformationalVersion>0.5.0-dev</InformationalVersion>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>Brian Rodriguez</Authors>
    <Product>Tesria</Product>
    <Copyright>Copyright 2026 Brian Rodriguez</Copyright>
    <!-- The built React SPA is copied into wwwroot at Docker build time and
         served as static files. -->
  </PropertyGroup>

  <!-- "Trust this device" (dev-plan 15.5): the certificate scripts, one copy
       in deploy/scripts, and the page's own script and stylesheet. Embedded
       so the image needs nothing beside the assembly; deploy/Dockerfile
       copies deploy/scripts into the build for this. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\deploy\scripts\trust-ca.sh" LogicalName="trust/trust-ca.sh" />
    <EmbeddedResource Include="..\..\deploy\scripts\trust-ca.ps1" LogicalName="trust/trust-ca.ps1" />
    <EmbeddedResource Include="Features\Trust\trust.js" LogicalName="trust/trust.js" />
    <EmbeddedResource Include="Features\Trust\trust.css" LogicalName="trust/trust.css" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data layer: EF Core 10 + PostgreSQL (Npgsql). Design package enables
         `dotnet ef` migrations at build/dev time. -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <!-- Persist Data Protection keys (auth-cookie signing) in the database so
         they survive container redeploys and are covered by DB backups.
         Pinned to 10.0.10 to clear GHSA-9mv3-2cwr-p262 in DataProtection. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <!-- Argon2id password hashing (PLAN §4: password hash = Argon2id). -->
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <!-- OIDC/SSO (PLAN §1: "architected for OIDC/SSO later", pluggable for
         Keycloak/Authentik/Google, etc.). Optional at runtime: see Oidc:Authority. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

</Project>
