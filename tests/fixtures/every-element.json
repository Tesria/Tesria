        { "type": "tableCell", "attrs": { "colspan": 1, "rowspan": 1, "colwidth": [120], "backgroundColor": "#abf5d1" }, "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Green background" }] }] },
        { "type": "tableCell", "attrs": { "colspan": 1, "rowspan": 1, "colwidth": null }, "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Column widths and cell colours are the thing that looked worst before 12.1." }] }] }
      ] },
      { "type": "tableRow", "content": [
        { "type": "tableCell", "attrs": { "colspan": 2, "rowspan": 1, "colwidth": [220, 120] }, "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "A cell spanning two columns" }] }] },
        { "type": "tableCell", "attrs": { "colspan": 1, "rowspan": 1, "colwidth": null }, "content": [{ "type": "bulletList", "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "A list inside a cell" }] }] }
        ] }] }
      ] }
    ] },

    { "type": "heading", "attrs": { "level": 1 }, "content": [{ "type": "text", "text": "Drawn and computed" }] },
