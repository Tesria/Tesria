{
  "type": "doc",
  "content": [
    { "type": "paragraph", "content": [{ "type": "text", "text": "Every element Tesria can put on a page, once each. This page is the fixture the export fidelity matrix is measured against (dev-plan 12.1); if something renders wrongly in a PDF or an exported site, it renders wrongly here first." }] },

    { "type": "tableOfContents" },

