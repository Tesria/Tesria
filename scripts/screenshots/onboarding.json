{
  "nameByTheme": true,
  "deviceScaleFactor": 1,
  "shots": [
    {
      "name": "setup",
      "url": "/spaces",
      "settle": 1200,
      "skipCapture": true,
      "steps": [
        {
          "eval": "(async () => { const H = { 'Content-Type': 'application/json', 'X-Requested-With': 'Tesria' }; const call = async (m, u, b) => { const r = await fetch(u, { method: m, credentials: 'include', headers: H, body: b ? JSON.stringify(b) : undefined }); return r.status === 204 ? null : r.json().catch(() => null) }; const doc = (t) => JSON.stringify({ type: 'doc', content: [{ type: 'paragraph', content: [{ type: 'text', text: t }] }] }); const sp = await call('POST', '/api/spaces', { Key: 'DEMO', Name: 'Getting started', Description: 'Everything a new arrival needs.' }); if (!sp || !sp.id) throw new Error('DEMO already exists, or could not be created'); const w = await call('POST', '/api/pages', { SpaceId: sp.id, ParentPageId: null, Title: 'Welcome', ContentJson: doc('A space holds pages, and a page holds everything else: text, tables, images and comments.') }); await call('POST', '/api/pages', { SpaceId: sp.id, ParentPageId: w.id, Title: 'Writing here', ContentJson: doc('Select any text to format it, or press slash on a blank line to insert something.') }); await call('POST', '/api/pages', { SpaceId: sp.id, ParentPageId: null, Title: 'House rules', ContentJson: doc('Write plainly. Link generously. Leave the page better than you found it.') }); const eng = await call('POST', '/api/spaces', { Key: 'DEMOENG', Name: 'Engineering', Description: 'How the thing is built.' }); if (eng && eng.id) await call('POST', '/api/pages', { SpaceId: eng.id, ParentPageId: null, Title: 'Architecture', ContentJson: doc('One service, one database, one editor.') }); const hb = await call('POST', '/api/spaces', { Key: 'DEMOHB', Name: 'Handbook', Description: 'How we work.' }); if (hb && hb.id) await call('POST', '/api/pages', { SpaceId: hb.id, ParentPageId: null, Title: 'Time off', ContentJson: doc('Take it. Tell someone first.') }); })()"
        },
        {
          "wait": 1000
        }
      ]
    },
