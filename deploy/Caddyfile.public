# Caddy configuration for hosting Tesria on the public internet.
#
# Select it in .env:   CADDYFILE=deploy/Caddyfile.public
#
# Differences from the default deploy/Caddyfile (which is for LAN and
# development use):
#
#  - NO catch-all :443 block with on-demand TLS. On a LAN that block is what
#    lets phones reach the wiki by IP or a .local name. On the internet it is
#    a liability: anyone who connects with an arbitrary server name gets a
#    certificate minted for it, for free, forever. Only {$DOMAIN} is served.
#  - HSTS is on. Browsers that have seen it once will refuse plain HTTP and
#    will refuse to let a user click past a certificate error: exactly what
#    you want on a real domain with a Let's Encrypt certificate, and exactly
#    what you do not want on `localhost` with an internal CA, which is why
#    the default file does not send it.
#  - Plain HTTP only redirects; /ca.crt is not served (there is no internal
#    CA to trust on a public deployment).
#
# Everything else (the app and collab proxies, compression, the upload size
# limit) is identical. The app itself adds the rest of the security headers
# (CSP, nosniff, frame-ancestors, ...), so they are not repeated here.
#
# Before pointing DNS at this, read docs/security.md's internet-readiness
# checklist.

{
	# Quoted, so an empty ACME_EMAIL is an empty address rather than a
	# missing one: Caddy refuses `email` with no argument (dev-plan 25.1),
	# and Let's Encrypt accepts an account without an email.
	email "{$ACME_EMAIL}"
	# Tailscale visitors: see the same setting in deploy/Caddyfile.
	servers {
		# No HTTP/3: the stack publishes TCP 443 only, and an offer of it
		# over a UDP port nobody listens on left Safari hanging (see
		# deploy/Caddyfile).
		protocols h1 h2
		trusted_proxies static {$TESRIA_TAILSCALE_ADDRESS:10.203.0.250}
	}
}

{$DOMAIN} {
	encode gzip zstd

	header {
		# Two years, subdomains included, preload-eligible. Remove
		# `preload` if you do not intend to submit to hstspreload.org.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# Caddy adds nothing else; the app sets the remaining headers on
		# every response so they are the same whichever proxy is in front.
	}

	handle /collab* {
		reverse_proxy collab:8090
	}

	handle {
		# Too large for the limits below: refused here, saying so, rather
		# than a 502 when the app closes the connection mid-upload (T5-024).
		@tooLarge {
			not path /api/spaces/import
			header_regexp Content-Length ^(\d{10,}|[1-9]\d{8})$
		}
		@packTooLarge {
			path /api/spaces/import
			header_regexp Content-Length ^(\d{10,}|[5-9]\d{8})$
		}
		header @tooLarge Content-Type application/problem+json
		header @packTooLarge Content-Type application/problem+json
		respond @tooLarge `{"title":"Payload Too Large","status":413,"detail":"This request is larger than Tesria accepts: 100 MB at most, and 25 MB for an attachment."}` 413
		respond @packTooLarge `{"title":"Payload Too Large","status":413,"detail":"This file is larger than a pack may be: 500 MB at most."}` 413

		reverse_proxy app:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Uploads: 100 MB, except a wiki pack import, which the format allows to
	# be 500 MB (WikiPack.MaxTotalBytes). One limit for both refused any pack
	# over 100 MB before the app saw it (found 2026-09-23). The two matchers
	# are exclusive, so exactly one limit applies to any request.
	@packImport path /api/spaces/import
	@notPackImport not path /api/spaces/import
	request_body @packImport {
		max_size 500MB
	}
	request_body @notPackImport {
		max_size 100MB
	}
}
