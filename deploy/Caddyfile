# Caddy reverse proxy for Tesria.
#
# {$DOMAIN} and {$ACME_EMAIL} come from the environment (see .env).
#
#  - Set DOMAIN to your real hostname (e.g. wiki.example.com) and Caddy will
#    obtain and auto-renew a Let's Encrypt certificate over HTTPS.
#  - Set DOMAIN to `localhost` for local testing; Caddy serves HTTPS using its
#    own internal CA (your browser will warn about the self-signed cert until
#    you trust it once: see docs/tls-and-lan-access.md).
#
# A second, catch-all block below serves anything reached by an address OTHER
# than {$DOMAIN}: your LAN IP, a `.local` hostname, 127.0.0.1, etc., with a
# certificate minted on the fly via Caddy's On-Demand TLS, using the same
# internal CA. No need to list every LAN IP/hostname by hand, and it keeps
# working even if your machine's LAN IP changes (DHCP). This is what makes the
# app reachable from other devices on your network, including phones/tablets.
#
# Both paths use the same internal root CA; trusting it once (see the docs
# and deploy/scripts/trust-ca.*) removes the browser warning everywhere,
# for every hostname/IP this server answers on.

{
	email {$ACME_EMAIL}
	# Clients that connect by raw IP address send no SNI at all (SNI is only
	# defined for hostnames, not IP literals), without this, Caddy falls back
	# to whatever certificate happens to be cached first, which is arbitrary
	# and confusing. Pin the fallback to {$DOMAIN}'s certificate so it's at
	# least deterministic. This does NOT make raw-IP access validate cleanly
	# (the SAN still won't match an IP): see docs/tls-and-lan-access.md for
	# why hostname-based LAN access (e.g. a `.local` name) is the reliable
	# path, not a bare IP.
	default_sni {$DOMAIN}
	# Caddy's automatic HTTPS otherwise inserts its own HTTP->HTTPS redirect
	# for {$DOMAIN} specifically, and that auto-inserted route wins over any
	# route in our own :80 block below for that hostname: found via testing:
	# curl -H "Host: localhost" (the managed hostname) got redirected before
	# ever reaching our /ca.crt exception, while any other Host reached it
	# fine. We already redirect everything else ourselves in the :80 block
	# below, so tell Caddy not to also add its own (cert automation for
	# {$DOMAIN} is unaffected: this only concerns the redirect route).
	auto_https disable_redirects
	# Real visitor addresses behind Docker Desktop (deploy/docker-desktop): a
	# forwarder on the Mac puts each visitor's address in front of the
	# connection (the PROXY protocol), and Caddy believes that line only from
	# PROXY_PROTOCOL_FROM. The default is loopback alone, which nothing here
	# connects from, so without deploy/docker-desktop this changes nothing. The
	# address then reaches the app as X-Forwarded-For, as before.
	servers {
		# Visitors through Tailscale (deploy/tailscale) arrive from the
		# Tailscale container, which names the real tailnet visitor in
		# X-Forwarded-For. That header is believed from that one fixed address
		# only (TESRIA_TAILSCALE_ADDRESS, docker-compose.yml); from anyone
		# else Caddy ignores it, so nobody can claim an address.
		trusted_proxies static {$TESRIA_TAILSCALE_ADDRESS:10.203.0.250}
		listener_wrappers {
			proxy_protocol {
				allow {$PROXY_PROTOCOL_FROM:127.0.0.1/32}
			}
			tls
		}
	}
}

# The internal CA's root certificate. The type is what lets an iPhone or an
# Android phone offer to install it rather than showing it as text, and the
# name is what the /trust page tells people to look for in their Downloads.
(ca_cert) {
	root * /data/caddy/pki/authorities/local
	rewrite * /root.crt
	header Content-Type application/x-x509-ca-cert
	header Content-Disposition "attachment; filename=\"tesria-ca.crt\""
	file_server
}

(app_proxy) {
	encode gzip zstd

	# The internal CA's root certificate, for clients to download and trust:
	# see deploy/scripts/trust-ca.sh / trust-ca.ps1. Not secret: this is the
	# public half of the CA, safe to serve to anyone who can reach this server.
	handle /ca.crt {
		import ca_cert
	}

	# Real-time collaboration websockets go to the Node sidecar. Caddy proxies
	# websocket upgrades transparently, so no extra configuration is needed.
	handle /collab* {
		reverse_proxy collab:8090
	}

	# Everything else is proxied to the app container, which serves both the API
	# (/api/*) and the React SPA.
	handle {
		reverse_proxy app:8080 {
			# One address for the app: the visitor Caddy worked out (the
			# PROXY line, a trusted Tailscale header, or the connection).
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Uploads: 100 MB, except a wiki pack import, which the format allows to
	# be 500 MB (WikiPack.MaxTotalBytes). One limit for both refused any pack
	# over 100 MB before the app saw it (found 2026-09-23). The two matchers
	# are exclusive, so exactly one limit applies to any request.
	@packImport path /api/spaces/import
	@notPackImport not path /api/spaces/import
	request_body @packImport {
		max_size 500MB
	}
	request_body @notPackImport {
		max_size 100MB
	}
}

{$DOMAIN} {
	import app_proxy
}

# Catch-all for LAN/mobile access via IP or another local hostname (anything
# not matching {$DOMAIN} above). Only reachable from wherever this server is
# network-reachable, if you expose port 443 straight to the public internet,
# firewall it to your LAN/VPN, since this will mint an internal cert for
# whatever hostname/SNI a client sends.
:443 {
	tls internal {
		on_demand
	}
	import app_proxy
}

# Same /ca.crt download over plain HTTP, so a brand-new client (nothing
# trusted yet) can fetch the root CA without needing to skip TLS verification
# first, and the /trust page that explains what to do with it. Everything
# else on port 80 still redirects to HTTPS as usual.
:80 {
	handle /ca.crt {
		import ca_cert
	}
	# "Trust this device" (dev-plan 15.5): the page that walks someone
	# through trusting the certificate above, and the scripts that do it.
	# Plain HTTP for the same reason as /ca.crt: nothing is trusted yet.
	@trust path /trust /trust/*
	handle @trust {
		reverse_proxy app:8080 {
			# One address for the app: the visitor Caddy worked out (the
			# PROXY line, a trusted Tailscale header, or the connection).
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
