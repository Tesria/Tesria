# --- Secrets / local config ---
.env
*.local

# --- .NET ---
bin/
obj/
*.user
[Dd]ebug/
[Rr]elease/

# --- Node / web ---
node_modules/
src/web/dist/

# --- Built SPA (generated into the API's wwwroot at Docker build time) ---
src/Api/wwwroot/*
!src/Api/wwwroot/.gitkeep

# --- Backups produced locally ---
backups/
*.dump

# --- OS / editor ---
.DS_Store
.vs/
.idea/
*.swp

# --- Local Claude Code tool config (machine-specific permissions) ---
.claude/

# Generated by `npm run build:mermaid`: a 3MB single-file Mermaid bundle that
# exported HTML pages carry inline. Built during the web build, never committed.
src/web/public/export/

# Generated by `npm run build:schema`: the editor schema and reconciliation,
# built for the collab sidecar (dev-plan 8.6). Built into the collab image,
# never committed, because a stale copy that disagrees with extensions.ts is
# the one failure the bundle exists to prevent.
collab/vendor/

# --- Local debug account credentials (never commit) ---
.debug-credentials

# --- The owner's NAS, for 9.2 offsite-backup work (never commit) ---
.nas-credentials
