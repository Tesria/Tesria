# Copy this file to `.env` and edit the values, then `docker compose up -d`.
# Do NOT commit your real .env: it contains secrets. (.gitignore excludes it.)

# --- Database ---------------------------------------------------------------
POSTGRES_USER=confluence
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=confluence

# Least-privilege role the running app uses (dev-plan 3.1). The app creates
# it at startup using POSTGRES_USER, then signs in as it; it cannot alter or
# delete audit rows. Generate: openssl rand -hex 24. Leaving it EMPTY runs
# the app as the database owner: fine on a LAN, not on the internet.
# To rotate: change the value and `docker compose up -d app collab`.
APP_DB_PASSWORD=change-me-to-a-different-long-random-string
# APP_DB_USER=tesria_app

# --- Public URL / TLS -------------------------------------------------------
# Real hostname -> Caddy gets an automatic Let's Encrypt certificate.
# Use `localhost` for local testing (Caddy serves HTTPS via its internal CA).
# Either way, the app is also reachable via LAN IP / other local hostnames
# (e.g. from your phone) with no extra config: see docs/tls-and-lan-access.md
# for how to make that warning-free too.
DOMAIN=localhost
ACME_EMAIL=you@example.com

# Which Caddy configuration to run. The default serves LAN/dev installs
# (internal CA, reachable by IP). Hosting on the public internet? Use
# deploy/Caddyfile.public: it turns on HSTS and removes the catch-all that
# would mint certificates for any name a stranger connects with. Read
# docs/security.md before doing so.
# CADDYFILE=deploy/Caddyfile.public

# The reverse proxy whose X-Forwarded-For the app believes. Leave empty for
# the compose stack. Only set this if you front the app with your own proxy.
# PROXY_TRUSTED_NETWORKS=10.0.0.5/32

# --- Real-time collaboration -------------------------------------------------
# Shared secret signing the short-lived tokens that authorise a user to join a
# page's live editing session. Generate one, e.g.: openssl rand -hex 32
# Leave EMPTY to disable co-editing (the editor falls back to single-user).
COLLAB_SHARED_SECRET=

# Shared secret the app uses to call the PDF rendering sidecar (dev-plan 8.1).
# Generate with: openssl rand -hex 32
# Leave empty to run without PDF export: the HTML export is unaffected, and
# the API then answers `?format=pdf` with a 503 telling the user to print it.
PDF_SHARED_SECRET=

# --- OIDC / SSO: supported but OFF by default -------------------------------
# Sign in via any standards-compliant OpenID Connect provider (Keycloak,
# Authentik, Google, Okta, ...) alongside local accounts. Leave OIDC_AUTHORITY
# empty to disable entirely. Register OIDC_CLIENT_ID with a redirect URI of
# https://<your-domain>/signin-oidc.
# OIDC_AUTHORITY=https://idp.example.com/realms/myrealm
# OIDC_CLIENT_ID=tesria
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Company SSO
# Only set to false for a same-network/dev IdP served over plain http, never
# appropriate once the IdP is reachable over a real network.
# OIDC_REQUIRE_HTTPS_METADATA=true

# --- Backups ----------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
# Physical (pgBackRest) backups: a new full backup once the newest is this
# many days old; incrementals in between.
BACKUP_FULL_EVERY_DAYS=7
# Read ONCE, on the first start after upgrading, as the starting point for the
# retention policy. After that, retention is set under Administration ->
# Backups and this value is ignored.
BACKUP_RETENTION_DAYS=14

# Passphrase encrypting the pgBackRest repository (physical backups + WAL).
# REQUIRED: set a long random string and keep it safe: without it, encrypted
# backups cannot be restored. Generate one, e.g.: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=change-me-to-a-long-random-passphrase

# --- Offsite backups (dev-plan 9.2) -----------------------------------------
# A copy of your backups somewhere that is not this machine. Three slots, at
# most one of each: cloud, a network drive, a removable disk. Configure the
# ones you have; leaving a slot empty turns it off.
#
# These live here and not in the admin page on purpose. Tesria's Data
# Protection keys are stored in the database, so a storage key held in the
# database would travel inside every backup along with the means to decrypt
# it: each backup would carry the key to delete itself. Nothing below is ever
# read by the app, only by the backup sidecars, and the admin page shows
# fingerprints rather than values.
#
# Every slot has its OWN passphrase, separate from BACKUP_ENCRYPTION_KEY and
# from each other, so that a leaked one does not read the others. A sidecar
# refuses a slot whose passphrase is missing rather than falling back to
# another. Escrow all of them somewhere off this machine: a lost passphrase
# is an unreadable copy, with no way back.

# Cloud (S3-compatible). Backblaze B2 is the documented default.
# OFFSITE_CLOUD_TYPE=b2
# OFFSITE_CLOUD_ENDPOINT=s3.us-west-000.backblazeb2.com
# OFFSITE_CLOUD_BUCKET=tesria-backups
# OFFSITE_CLOUD_REGION=us-west-000
# OFFSITE_CLOUD_PATH=/tesria
# B2 and AWS want host-style URIs; MinIO and most self-hosted gateways want
# path. If backups fail with a DNS or 404 error, this is the first thing to try.
# OFFSITE_CLOUD_URI_STYLE=host
# OFFSITE_CLOUD_KEY=
# OFFSITE_CLOUD_SECRET=
# openssl rand -hex 32
# OFFSITE_CLOUD_PASSPHRASE=
# Full backups kept in the cloud repository. Its own, not the admin page's:
# the offsite copy is usually kept longer and taken less often.
# OFFSITE_CLOUD_RETENTION_FULL=4
# How often a full backup is pushed to the cloud, in days. WAL streams
# continuously regardless, so recovery to a point in time does not wait.
# OFFSITE_CLOUD_BACKUP_EVERY_DAYS=7

# How much unarchived WAL may pile up before pgBackRest drops segments to save
# the disk. Only applies when a cloud target is configured, because that is
# when a remote can go away and stop WAL being acknowledged. Past this limit,
# point-in-time recovery is broken until the next backup, and you are alerted.
# Set it comfortably under the free space on the pgdata volume.
# OFFSITE_ARCHIVE_QUEUE_MAX=16GiB

# Network drive and removable disk: reserved for 9.2 steps 3 and 4. Nothing
# reads these yet.
# OFFSITE_NAS_PATH=/mnt/nas
# OFFSITE_NAS_PASSPHRASE=
# OFFSITE_REMOVABLE_PATH=/mnt/removable
# OFFSITE_REMOVABLE_PASSPHRASE=
